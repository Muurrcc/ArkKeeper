<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\arkkeeper.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArkKeeper.Core\ArkKeeper.Core.csproj" />
    <ProjectReference Include="..\ArkKeeper.Networking\ArkKeeper.Networking.csproj" />
    <ProjectReference Include="..\ArkKeeper.Discord\ArkKeeper.Discord.csproj" />
    <ProjectReference Include="..\ArkKeeper.Updater\ArkKeeper.Updater.csproj" />
    <ProjectReference Include="..\ArkKeeper.Orchestration\ArkKeeper.Orchestration.csproj" />
  </ItemGroup>

  <!-- SkiaSharp/HarfBuzzSharp ship their native debug symbols (.pdb) as content, which
       DebugType=none doesn't touch since it's not our own assembly's pdb. They add ~100MB
       for no benefit in a shipped Release build, so strip them after publish. -->
  <Target Name="RemoveNativeDebugSymbols" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <NativePdbToRemove Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(NativePdbToRemove)" />
  </Target>
</Project>
