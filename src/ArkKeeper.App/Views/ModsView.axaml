<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArkKeeper.App.ViewModels"
             xmlns:conv="using:ArkKeeper.App.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ArkKeeper.App.Views.ModsView"
             x:DataType="vm:ModsViewModel"
             x:Name="Root">

    <DockPanel Margin="24">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Mods" />
                <TextBlock Text="{Binding Profile.ProfileName}" Opacity="0.7" />
            </StackPanel>
            <Button Grid.Column="1" Classes="Pill" Content="Close" Command="{Binding CloseCommand}" />
        </Grid>

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                   Margin="0,0,0,12" TextWrapping="Wrap" />

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0" Text="{Binding NewModId}"
                      PlaceholderText="Steam Workshop item ID (e.g. 12345678)" />
            <Button Grid.Column="1" Classes="Pill" Content="Add" Command="{Binding AddCommand}" Margin="8,0,0,0" />
        </Grid>

        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding ModIds}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Classes="Card" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="Pill" Content="Remove"
                                    Command="{Binding #Root.((vm:ModsViewModel)DataContext).RemoveCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
            <Button Classes="Pill accent" Content="Download / update all mods"
                    Command="{Binding DownloadAllCommand}" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}" VerticalAlignment="Center">
                <Border Classes="IconCircle Live" Width="10" Height="10"
                        Background="{DynamicResource SystemFillColorAttentionBrush}" />
                <TextBlock Text="Downloading — this can take a while" Opacity="0.75" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                     Height="4" Margin="0,0,0,8" />

        <TextBlock DockPanel.Dock="Top" Text="{Binding LatestProgressLine}"
                   IsVisible="{Binding LatestProgressLine, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                   FontFamily="Consolas,Cascadia Mono,monospace" FontWeight="SemiBold" FontSize="12"
                   Margin="0,0,0,8" TextWrapping="Wrap" />

        <StackPanel>
            <Border Classes="Card">
                <ScrollViewer x:Name="ProgressLogScroll">
                    <TextBlock Text="{Binding ProgressLog}" FontFamily="Consolas,Cascadia Mono,monospace"
                               FontSize="12" TextWrapping="Wrap" SizeChanged="OnProgressLogSizeChanged" />
                </ScrollViewer>
            </Border>

            <!-- Below the log, only while it's actually running — a way out of a long mod
                 download without having to wait it out. -->
            <Border Classes="Card" IsVisible="{Binding IsBusy}" Margin="0,8,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Downloading in the background — you can quit if you don't want to wait."
                               Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="Danger" Content="Quit"
                            Command="{Binding QuitDownloadCommand}" Margin="12,0,0,0" />
                </Grid>
            </Border>
        </StackPanel>
    </DockPanel>
</UserControl>
