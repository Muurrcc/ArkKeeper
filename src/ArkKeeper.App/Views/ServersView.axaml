<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArkKeeper.App.ViewModels"
             xmlns:conv="using:ArkKeeper.App.Converters"
             xmlns:profiles="using:ArkKeeper.Core.Profiles"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ArkKeeper.App.Views.ServersView"
             x:DataType="vm:ServersViewModel">

    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Servers" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

        <ItemsControl ItemsSource="{Binding Profiles}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="profiles:ServerProfile">
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="{Binding SessionName}" Opacity="0.7" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2" Margin="16,0" HorizontalAlignment="Right">
                                <TextBlock Text="Port" Opacity="0.6" FontSize="11" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding Port}" HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2" Margin="16,0" HorizontalAlignment="Right">
                                <TextBlock Text="Max players" Opacity="0.6" FontSize="11" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding MaxPlayers}" HorizontalAlignment="Right" />
                            </StackPanel>
                            <Border Grid.Column="3" CornerRadius="4" Padding="8,4" VerticalAlignment="Center"
                                    Background="{DynamicResource SystemFillColorSuccessBrush}">
                                <TextBlock Text="{Binding PveMode, Converter={x:Static conv:PveBadgeConverter.Instance}}" FontSize="12" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
