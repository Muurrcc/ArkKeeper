<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArkKeeper.App.ViewModels"
             xmlns:conv="using:ArkKeeper.App.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ArkKeeper.App.Views.ServersView"
             x:DataType="vm:ServersViewModel"
             x:Name="Root">

    <DockPanel Margin="24">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Column="0" Text="Servers" FontSize="24" FontWeight="SemiBold" />
            <Button Grid.Column="1" Classes="Pill accent" Content="Add server" Command="{Binding AddServerCommand}" />
        </Grid>

        <TextBlock DockPanel.Dock="Top"
                   Text="No servers yet — click &quot;Add server&quot; to create your first profile."
                   Opacity="0.7" Margin="0,0,0,16"
                   IsVisible="{Binding IsEmpty}" />

        <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Servers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ServerRowViewModel">
                    <Border Classes="Card" Margin="0,0,0,12">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <Border Grid.Column="0" Classes="IconCircle" Classes.Live="{Binding IsRunning}"
                                        Width="34" Height="34" Margin="0,0,14,0">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding IsRunning, Converter={x:Static conv:RunningColorConverter.Instance}}" />
                                    </Border.Background>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="2" MinWidth="120" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Profile.ProfileName}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{Binding Profile.SessionName}" Opacity="0.7" FontSize="12" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="2" Margin="16,0" HorizontalAlignment="Right">
                                    <TextBlock Text="Port" Opacity="0.6" FontSize="11" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Profile.Port}" HorizontalAlignment="Right" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Spacing="2" Margin="16,0" HorizontalAlignment="Right">
                                    <TextBlock Text="Max players" Opacity="0.6" FontSize="11" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Profile.MaxPlayers}" HorizontalAlignment="Right" />
                                </StackPanel>

                                <Border Grid.Column="4" Classes="PillSmall" VerticalAlignment="Center"
                                        Background="{DynamicResource SystemFillColorSuccessBrush}">
                                    <TextBlock Text="{Binding Profile.PveMode, Converter={x:Static conv:PveBadgeConverter.Instance}}" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <StackPanel Spacing="8">
                                <!-- Power controls, left, and profile actions, right — kept apart
                                     from the feature-page buttons below so Start/Stop/Kill and
                                     Edit/Delete (the ones with real consequences) aren't lost in
                                     one long row of equally-weighted buttons. -->
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <StackPanel.Styles>
                                            <Style Selector="Button"><Setter Property="CornerRadius" Value="10" /></Style>
                                        </StackPanel.Styles>
                                        <Button Content="Start" Classes="accent" Command="{Binding StartCommand}" />
                                        <Button Content="Stop" Command="{Binding StopCommand}" />
                                        <Button Content="Kill" Classes="Danger" Command="{Binding KillCommand}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <StackPanel.Styles>
                                            <Style Selector="Button"><Setter Property="CornerRadius" Value="10" /></Style>
                                        </StackPanel.Styles>
                                        <Button Content="Edit"
                                                Command="{Binding #Root.((vm:ServersViewModel)DataContext).EditCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Delete" Classes="Danger"
                                                Command="{Binding #Root.((vm:ServersViewModel)DataContext).DeleteCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Orientation="Horizontal">
                                    <WrapPanel.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Margin" Value="0,0,8,8" />
                                            <Setter Property="CornerRadius" Value="10" />
                                        </Style>
                                    </WrapPanel.Styles>
                                    <Button Content="Console"
                                            Command="{Binding #Root.((vm:ServersViewModel)DataContext).ConsoleCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Players"
                                            Command="{Binding #Root.((vm:ServersViewModel)DataContext).PlayersCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Backups"
                                            Command="{Binding #Root.((vm:ServersViewModel)DataContext).BackupsCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Scheduler"
                                            Command="{Binding #Root.((vm:ServersViewModel)DataContext).SchedulerCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Mods"
                                            Command="{Binding #Root.((vm:ServersViewModel)DataContext).ModsCommand}"
                                            CommandParameter="{Binding}" />
                                </WrapPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding ErrorMessage}"
                                       IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
