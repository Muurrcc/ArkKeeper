<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArkKeeper.App.ViewModels"
             xmlns:conv="using:ArkKeeper.App.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ArkKeeper.App.Views.ServersView"
             x:DataType="vm:ServersViewModel">

    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Servers" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

        <ItemsControl ItemsSource="{Binding Servers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ServerRowViewModel">
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding IsRunning, Converter={x:Static conv:RunningColorConverter.Instance}}" />
                                    </Ellipse.Fill>
                                </Ellipse>

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Profile.ProfileName}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{Binding Profile.SessionName}" Opacity="0.7" FontSize="12" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="2" Margin="16,0" HorizontalAlignment="Right">
                                    <TextBlock Text="Port" Opacity="0.6" FontSize="11" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Profile.Port}" HorizontalAlignment="Right" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Spacing="2" Margin="16,0" HorizontalAlignment="Right">
                                    <TextBlock Text="Max players" Opacity="0.6" FontSize="11" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Profile.MaxPlayers}" HorizontalAlignment="Right" />
                                </StackPanel>

                                <Border Grid.Column="4" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0"
                                        Background="{DynamicResource SystemFillColorSuccessBrush}">
                                    <TextBlock Text="{Binding Profile.PveMode, Converter={x:Static conv:PveBadgeConverter.Instance}}" FontSize="12" />
                                </Border>

                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Start" Command="{Binding StartCommand}" />
                                    <Button Content="Stop" Command="{Binding StopCommand}" />
                                    <Button Content="Kill" Command="{Binding KillCommand}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding ErrorMessage}"
                                       IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
