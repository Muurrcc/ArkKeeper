<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArkKeeper.App.ViewModels"
             xmlns:conv="using:ArkKeeper.App.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ArkKeeper.App.Views.ProfileEditorView"
             x:DataType="vm:ProfileEditorViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="Grid.FieldRow">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="24">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Column="0" FontSize="24" FontWeight="SemiBold"
                       Text="{Binding IsNew, Converter={x:Static conv:BoolToNewOrEditTitleConverter.Instance}}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" />
            </StackPanel>
        </Grid>

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Margin="0,0,0,12" TextWrapping="Wrap" />

        <ScrollViewer>
            <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">

                <Expander Header="General" IsExpanded="True">
                    <StackPanel Margin="0,12,0,0">
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Profile name" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.ProfileName}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Session name (shown in-game)" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.SessionName}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Map" />
                            <AutoCompleteBox Grid.Column="1" ItemsSource="{Binding AvailableMaps}"
                                              Text="{Binding Profile.MapName}" FilterMode="StartsWith" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Install directory" />
                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding Profile.InstallDirectory}"
                                          PlaceholderText="Where SteamCMD installed the server" />
                                <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0"
                                        Click="OnBrowseInstallDirectoryClick" />
                            </Grid>
                        </Grid>

                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" />
                            <Button Grid.Column="1" Content="Install / update server"
                                    Command="{Binding InstallServerCommand}" HorizontalAlignment="Left" />
                        </Grid>

                        <TextBlock Text="{Binding InstallErrorMessage}"
                                   IsVisible="{Binding InstallErrorMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding InstallStatusMessage}"
                                   IsVisible="{Binding InstallStatusMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   Margin="0,0,0,8" TextWrapping="Wrap" />

                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="10"
                                IsVisible="{Binding InstallProgressLog, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                                MaxHeight="200">
                            <ScrollViewer>
                                <TextBlock Text="{Binding InstallProgressLog}" FontFamily="Consolas,Cascadia Mono,monospace"
                                           FontSize="11" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Expander>

                <Expander Header="Network" IsExpanded="True">
                    <StackPanel Margin="0,12,0,0">
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Game port" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.Port}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Query port" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.QueryPort}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="RCON enabled" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.RconEnabled}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="RCON port" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.RconPort}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander Header="Passwords" IsExpanded="False">
                    <StackPanel Margin="0,12,0,0">
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Server password (empty = public)" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.ServerPassword}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Admin password" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.AdminPassword}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Spectator password" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.SpectatorPassword}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander Header="Rules" IsExpanded="False">
                    <StackPanel Margin="0,12,0,0">
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Max players" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.MaxPlayers}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="PvE mode" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.PveMode}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Hardcore" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.Hardcore}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Show crosshair" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.ShowCrosshair}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Allow third person" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.AllowThirdPerson}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander Header="Rates &amp; multipliers" IsExpanded="False">
                    <StackPanel Margin="0,12,0,0">
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Difficulty offset" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.DifficultyOffset}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="XP multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.XpMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Taming speed multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.TamingSpeedMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Harvest amount multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.HarvestAmountMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="200,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Day cycle speed scale" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.DayCycleSpeedScale}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <CheckBox Content="Advanced config" IsChecked="{Binding ShowAdvancedConfig}" />

                <StackPanel Spacing="12" IsVisible="{Binding ShowAdvancedConfig}">

                <Expander Header="Chat and Social" IsExpanded="False">
                    <StackPanel Margin="0,12,0,0">
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Admin Logging" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.AdminLogging}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Allow Tribe Alliances" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.AllowTribeAlliances}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Ban List URL" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.BanListURL}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Enable Global Voice Chat" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.EnableGlobalVoiceChat}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Enable Player Joined Notifications" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.EnablePlayerJoinedNotifications}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Enable Player Leave Notifications" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.EnablePlayerLeaveNotifications}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Enable Proximity Chat" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.EnableProximityChat}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Max Alliances Per Tribe" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.MaxAlliancesPerTribe}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Max Number Of Players In Tribe" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.MaxNumberOfPlayersInTribe}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Max Tribe Logs" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.MaxTribeLogs}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Max Tribes Per Alliance" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.MaxTribesPerAlliance}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="MOTD" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.MOTD}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="MOTDDuration" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.MOTDDuration}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="RCONServer Game Log Buffer" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.RCONServerGameLogBuffer}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="SOTF_Battle Num Of Tribes To Start Game" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.SOTF_BattleNumOfTribesToStartGame}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="SOTF_Max Number Of Players In Tribe" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.SOTF_MaxNumberOfPlayersInTribe}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Tribe Name Change Cooldown" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.TribeNameChangeCooldown}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander Header="Dinos and Taming" IsExpanded="False">
                    <StackPanel Margin="0,12,0,0">
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Allow Anyone Baby Imprint Cuddle" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.AllowAnyoneBabyImprintCuddle}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Allow Raid Dino Feeding" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.AllowRaidDinoFeeding}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Auto Destroy Decayed Dinos" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.AutoDestroyDecayedDinos}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Baby Cuddle Grace Period Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.BabyCuddleGracePeriodMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Baby Cuddle Interval Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.BabyCuddleIntervalMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Baby Cuddle Lose Imprint Quality Speed Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.BabyCuddleLoseImprintQualitySpeedMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Baby Food Consumption Speed Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.BabyFoodConsumptionSpeedMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Baby Imprinting Stat Scale Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.BabyImprintingStatScaleMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Baby Mature Speed Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.BabyMatureSpeedMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Cross ARKAllow Foreign Dino Downloads" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.CrossARKAllowForeignDinoDownloads}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Dino Character Food Drain Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.DinoCharacterFoodDrainMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Dino Character Health Recovery Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.DinoCharacterHealthRecoveryMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Dino Character Stamina Drain Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.DinoCharacterStaminaDrainMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Dino Count Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.DinoCountMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Dino Damage Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.DinoDamageMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Dino Harvesting Damage Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.DinoHarvestingDamageMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Dino Resistance Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.DinoResistanceMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Disable Dino Decay Pv E" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.DisableDinoDecayPvE}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Disable Dino Decay Pv P" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.DisableDinoDecayPvP}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Disable Dino Riding" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.DisableDinoRiding}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Disable Dino Taming" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.DisableDinoTaming}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Disable Imprint Dino Buff" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.DisableImprintDinoBuff}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Egg Hatch Speed Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.EggHatchSpeedMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Lay Egg Interval Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.LayEggIntervalMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Mating Interval Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.MatingIntervalMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Max Personal Tamed Dinos" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.MaxPersonalTamedDinos}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Max Tamed Dinos" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.MaxTamedDinos}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Minimum Dino Reupload Interval" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.MinimumDinoReuploadInterval}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Override Max Experience Points Dino" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.OverrideMaxExperiencePointsDino}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Passive Defenses Damage Riderless Dinos" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.PassiveDefensesDamageRiderlessDinos}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Passive Tame Interval Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.PassiveTameIntervalMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Prevent Download Dinos" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.PreventDownloadDinos}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Prevent Upload Dinos" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.PreventUploadDinos}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Pv EDino Decay Period Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.PvEDinoDecayPeriodMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Raid Dino Character Food Drain Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.RaidDinoCharacterFoodDrainMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Server Auto Force Respawn Wild Dinos Interval" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.ServerAutoForceRespawnWildDinosInterval}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Tamed Dino Character Food Drain Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.TamedDinoCharacterFoodDrainMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Tamed Dino Damage Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.TamedDinoDamageMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Tamed Dino Resistance Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.TamedDinoResistanceMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Tamed Dino Torpor Drain Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.TamedDinoTorporDrainMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Tribute Dino Expiration Seconds" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.TributeDinoExpirationSeconds}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Wild Dino Character Food Drain Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.WildDinoCharacterFoodDrainMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Wild Dino Torpor Drain Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.WildDinoTorporDrainMultiplier}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander Header="Items, Engrams and Crafting" IsExpanded="False">
                    <StackPanel Margin="0,12,0,0">
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Allow Custom Recipes" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.AllowCustomRecipes}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Auto Unlock All Engrams" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.AutoUnlockAllEngrams}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Clamp Item Spoiling Times" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.ClampItemSpoilingTimes}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Crafting Skill Bonus Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.CraftingSkillBonusMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Craft XPMultiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.CraftXPMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Custom Recipe Effectiveness Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.CustomRecipeEffectivenessMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Custom Recipe Skill Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.CustomRecipeSkillMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
