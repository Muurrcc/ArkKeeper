                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Structure Resistance Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.StructureResistanceMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Tribe Log Destroyed Enemy Structures" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.TribeLogDestroyedEnemyStructures}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Use Tame Limit For Structures Only" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.UseTameLimitForStructuresOnly}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander Header="World and Environment" IsExpanded="False">
                    <StackPanel Margin="0,12,0,0">
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Crop Decay Speed Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.CropDecaySpeedMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Day Time Speed Scale" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.DayTimeSpeedScale}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Disable Weather Fog" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.DisableWeatherFog}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Extinction Event Time Interval" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.ExtinctionEventTimeInterval}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Extinction Event UTC" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.ExtinctionEventUTC}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Fast Decay Interval" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.FastDecayInterval}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Global Corpse Decomposition Time Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.GlobalCorpseDecompositionTimeMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Night Time Speed Scale" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.NightTimeSpeedScale}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Player Character Food Drain Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.PlayerCharacterFoodDrainMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Player Character Stamina Drain Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.PlayerCharacterStaminaDrainMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Player Character Water Drain Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.PlayerCharacterWaterDrainMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Poop Interval Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.PoopIntervalMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Resources Respawn Period Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.ResourcesRespawnPeriodMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="SOTF_Battle Auto Restart Game Interval" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.SOTF_BattleAutoRestartGameInterval}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="SOTF_Battle Auto Start Game Interval" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.SOTF_BattleAutoStartGameInterval}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="SOTF_Battle Sudden Death Interval" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.SOTF_BattleSuddenDeathInterval}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Use Corpse Life Span Multiplier" />
                            <TextBox Grid.Column="1" Text="{Binding Profile.UseCorpseLifeSpanMultiplier}" />
                        </Grid>
                        <Grid Classes="FieldRow" ColumnDefinitions="260,*">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Use Corpse Locator" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Profile.UseCorpseLocator}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander Header="Advanced overrides (raw values)" IsExpanded="False">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="One entry per line, in the exact format the game .ini expects (e.g. an override list entry looks like (ClassName=&quot;Rex_Character_BP_C&quot;,Multiplier=1.5)). Advanced - leave empty unless you know the exact syntax."
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Classes="FieldLabel" Text="Config Add NPCSpawn Entries Container" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Profile.ConfigAddNPCSpawnEntriesContainer, Converter={x:Static conv:StringListConverter.Instance}}"
                                  AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12" FontFamily="Consolas,Cascadia Mono,monospace" FontSize="11" />
                        <TextBlock Classes="FieldLabel" Text="Config Override Item Crafting Costs" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Profile.ConfigOverrideItemCraftingCosts, Converter={x:Static conv:StringListConverter.Instance}}"
                                  AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12" FontFamily="Consolas,Cascadia Mono,monospace" FontSize="11" />
                        <TextBlock Classes="FieldLabel" Text="Config Override NPCSpawn Entries Container" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Profile.ConfigOverrideNPCSpawnEntriesContainer, Converter={x:Static conv:StringListConverter.Instance}}"
                                  AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12" FontFamily="Consolas,Cascadia Mono,monospace" FontSize="11" />
                        <TextBlock Classes="FieldLabel" Text="Config Override Supply Crate Items" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Profile.ConfigOverrideSupplyCrateItems, Converter={x:Static conv:StringListConverter.Instance}}"
                                  AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12" FontFamily="Consolas,Cascadia Mono,monospace" FontSize="11" />
                        <TextBlock Classes="FieldLabel" Text="Config Subtract NPCSpawn Entries Container" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Profile.ConfigSubtractNPCSpawnEntriesContainer, Converter={x:Static conv:StringListConverter.Instance}}"
                                  AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12" FontFamily="Consolas,Cascadia Mono,monospace" FontSize="11" />
                        <TextBlock Classes="FieldLabel" Text="Dino Class Damage Multipliers" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Profile.DinoClassDamageMultipliers, Converter={x:Static conv:StringListConverter.Instance}}"
                                  AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12" FontFamily="Consolas,Cascadia Mono,monospace" FontSize="11" />
                        <TextBlock Classes="FieldLabel" Text="Dino Class Resistance Multipliers" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Profile.DinoClassResistanceMultipliers, Converter={x:Static conv:StringListConverter.Instance}}"
                                  AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12" FontFamily="Consolas,Cascadia Mono,monospace" FontSize="11" />
                        <TextBlock Classes="FieldLabel" Text="Dino Spawn Weight Multipliers" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Profile.DinoSpawnWeightMultipliers, Converter={x:Static conv:StringListConverter.Instance}}"
                                  AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12" FontFamily="Consolas,Cascadia Mono,monospace" FontSize="11" />
                        <TextBlock Classes="FieldLabel" Text="Harvest Resource Item Amount Class Multipliers" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Profile.HarvestResourceItemAmountClassMultipliers, Converter={x:Static conv:StringListConverter.Instance}}"
                                  AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12" FontFamily="Consolas,Cascadia Mono,monospace" FontSize="11" />
                        <TextBlock Classes="FieldLabel" Text="NPCReplacements" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Profile.NPCReplacements, Converter={x:Static conv:StringListConverter.Instance}}"
                                  AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12" FontFamily="Consolas,Cascadia Mono,monospace" FontSize="11" />
                        <TextBlock Classes="FieldLabel" Text="Override Named Engram Entries" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Profile.OverrideNamedEngramEntries, Converter={x:Static conv:StringListConverter.Instance}}"
                                  AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12" FontFamily="Consolas,Cascadia Mono,monospace" FontSize="11" />
                        <TextBlock Classes="FieldLabel" Text="Prevent Dino Tame Class Names" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Profile.PreventDinoTameClassNames, Converter={x:Static conv:StringListConverter.Instance}}"
                                  AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12" FontFamily="Consolas,Cascadia Mono,monospace" FontSize="11" />
                        <TextBlock Classes="FieldLabel" Text="Tamed Dino Class Damage Multipliers" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Profile.TamedDinoClassDamageMultipliers, Converter={x:Static conv:StringListConverter.Instance}}"
                                  AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12" FontFamily="Consolas,Cascadia Mono,monospace" FontSize="11" />
                        <TextBlock Classes="FieldLabel" Text="Tamed Dino Class Resistance Multipliers" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Profile.TamedDinoClassResistanceMultipliers, Converter={x:Static conv:StringListConverter.Instance}}"
                                  AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12" FontFamily="Consolas,Cascadia Mono,monospace" FontSize="11" />
                    </StackPanel>
                </Expander>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
