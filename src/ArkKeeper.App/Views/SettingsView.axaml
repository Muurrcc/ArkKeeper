<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArkKeeper.App.ViewModels"
             xmlns:services="using:ArkKeeper.App.Services"
             xmlns:conv="using:ArkKeeper.App.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ArkKeeper.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="20" MaxWidth="560">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />

            <TextBlock Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" TextWrapping="Wrap" />

            <Border Classes="Card">
            <StackPanel Spacing="8">
                <TextBlock Text="Appearance" FontWeight="SemiBold" />
                <TextBlock Text="Theme" Opacity="0.8" FontSize="12" />
                <ComboBox ItemsSource="{Binding ThemeKinds}" SelectedItem="{Binding ThemeKind}"
                          AutomationProperties.AutomationId="ThemeComboBox"
                          HorizontalAlignment="Left" MinWidth="180">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static conv:ThemeKindDisplayConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            </Border>

            <Border Classes="Card">
            <StackPanel Spacing="8">
                <TextBlock Text="Accent color" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding AccentSwatches}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:AccentSwatch">
                            <Button Width="32" Height="32" CornerRadius="10" Padding="0"
                                    Background="{Binding Brush}" ToolTip.Tip="{Binding Name}"
                                    Command="{Binding $parent[ItemsControl].DataContext.ApplyAccentCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            </Border>

            <Border Classes="Card">
            <StackPanel Spacing="8">
                <TextBlock Text="Installs" FontWeight="SemiBold" />
                <TextBlock Text="Default install directory" Opacity="0.8" FontSize="12" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding DefaultInstallDirectory}"
                              PlaceholderText="Used to pre-fill new profiles" />
                    <Button Grid.Column="1" Classes="Pill" Content="Browse..." Margin="8,0,0,0"
                            Click="OnBrowseDefaultInstallDirectoryClick" />
                </Grid>
                <TextBlock Text="SteamCMD directory" Opacity="0.8" FontSize="12" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding SteamCmdDirectory}"
                              PlaceholderText="Where steamcmd.exe is (or will be) installed" />
                    <Button Grid.Column="1" Classes="Pill" Content="Browse..." Margin="8,0,0,0"
                            Click="OnBrowseSteamCmdDirectoryClick" />
                </Grid>
            </StackPanel>
            </Border>

            <Border Classes="Card">
            <StackPanel Spacing="8">
                <TextBlock Text="Discord notifications" FontWeight="SemiBold" />
                <TextBlock Text="Webhook URL" Opacity="0.8" FontSize="12" />
                <TextBox Text="{Binding DiscordWebhookUrl}"
                          PlaceholderText="https://discord.com/api/webhooks/..." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="Pill" Content="Send test message" Command="{Binding SendTestDiscordMessageCommand}" />
                </StackPanel>
            </StackPanel>
            </Border>

            <Border Classes="Card">
            <StackPanel Spacing="8">
                <TextBlock Text="Updates" FontWeight="SemiBold" />
                <TextBlock Opacity="0.6" FontSize="12">
                    <Run Text="Current version: " /><Run Text="{Binding CurrentVersion}" />
                </TextBlock>
                <TextBlock Text="Manifest URL" Opacity="0.8" FontSize="12" />
                <TextBox Text="{Binding UpdateManifestUrl}"
                          PlaceholderText="URL of a JSON {LatestVersion, DownloadUrl} manifest" />

                <TextBlock Text="{Binding UpdateErrorMessage}"
                           IsVisible="{Binding UpdateErrorMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding UpdateStatusMessage}"
                           IsVisible="{Binding UpdateStatusMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="Pill" Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" />
                    <Button Classes="Pill" Content="Download update" Command="{Binding DownloadUpdateCommand}" />
                </StackPanel>
            </StackPanel>
            </Border>

            <Border Classes="Card">
            <StackPanel Spacing="8">
                <TextBlock Text="Version" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Classes="StatNumber" Text="{Binding CurrentVersion}" />
                    <Border Classes="PillSmall" Background="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center">
                        <TextBlock Text="ArkKeeper" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <TextBlock Text="What's new" FontWeight="SemiBold" Margin="0,12,0,0" />
                <ItemsControl ItemsSource="{Binding ChangelogEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:ChangelogEntry">
                            <StackPanel Spacing="4" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Version}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding Date}" Opacity="0.5" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Highlights}" Margin="4,2,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Opacity="0.8" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0">
                                                <Run Text="•  " /><Run Text="{Binding}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            </Border>

            <Button Classes="Pill accent" Content="Save settings" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
