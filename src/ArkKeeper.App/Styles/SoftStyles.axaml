<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared "soft" design language: rounded-rectangle cards and badges (moderate corner
         radius, never a full pill/circle — deliberately rectangular, per explicit direction) and
         big bold numbers, applied via style classes so every page opts in with Classes="Card"
         etc. instead of repeating CornerRadius/padding by hand everywhere. -->

    <Style Selector="Border.Card">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    </Style>

    <Style Selector="Border.Pill">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style Selector="Border.PillSmall">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <!-- A rounded-square icon badge: pair with an explicit equal Width/Height on the element. -->
    <Style Selector="Border.IconCircle">
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="TextBlock.BigNumber">
        <Setter Property="FontSize" Value="52" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.StatNumber">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.Pill">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

</Styles>
